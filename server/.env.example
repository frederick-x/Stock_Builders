# Example environment file for the LLM proxy server
# Set these before starting the server

# Full provider API URL that accepts POST JSON body with `{ prompt }`.
# For Gemini/Vertex you may need the full endpoint; for OpenAI use https://api.openai.com/v1/chat/completions
LLM_API_URL=

# Provider API key (kept secret on the server)
LLM_API_KEY=

# Optional server port
PORT=3001

# Provider type: 'gemini'|'vertex'|'openai'|'generic' (controls request formatting)
LLM_PROVIDER=gemini

# Optional model name (for OpenAI or provider that needs explicit model)
LLM_MODEL=

# Notes:
# - Do NOT put your API key into client-side code. Keep it here on the server only.
# - If using Gemini/Vertex AI, consult provider docs for exact request format and endpoint.
